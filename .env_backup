# ============================================================
#  Copy to .env and fill in.   cp .env.example .env
# ============================================================

# ---------- Slack ----------
# The token lines are commented out on purpose: your ~/.zprofile.sh already
# exports SLACK_BOT_TOKEN / SLACK_SOCKET_TOKEN / SLACK_CHANNEL_ID, and a placeholder
# here could shadow the real value. Uncomment only what your shell doesn't export.
# socket = WebSocket, no public URL (laptop/dev, behind a firewall)
# http   = Slack POSTs to https://<host>/slack/events (prod, serverless, k8s)
SLACK_MODE=socket


SLACK_BOT_TOKEN=
SLACK_SOCKET_TOKEN=x
SLACK_SIGNING_SECRET=your-signing-secret
OPENAI_API_KEY=sk-p

SLACK_CHANNEL_ID=

# OAuth & Permissions -> Bot User OAuth Token
# SLACK_BOT_TOKEN=xoxb-...

# Basic Information -> App-Level Tokens (scope: connections:write). Socket Mode only.
# SLACK_SOCKET_TOKEN is accepted too (same thing, older name).
# SLACK_APP_TOKEN=xapp-...

# Basic Information -> App Credentials -> Signing Secret. Required for HTTP mode.
# SLACK_SIGNING_SECRET=...

# Default channel for POST /api/slack/notify (right-click channel -> View details -> bottom)
# SLACK_CHANNEL_ID=C0123456789

# Slash command names (must match what you created in the Slack app)
SLACK_CMD_AGENT=/agent
SLACK_CMD_ADD=/agent-add

# ---------- LLM (any OpenAI-compatible endpoint) ----------
# Your ~/.zprofile.sh already exports OPENROUTER_API_KEY; it is picked up automatically
# (and an sk-or-... key points the client at OpenRouter by itself). Or set one of:
#   OPENROUTER_API_KEY / OPENAI_API_KEY / LLM_API_KEY
# OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=openai/gpt-4o-mini            # OpenRouter model id; use gpt-4o-mini with a plain OpenAI key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1     # OpenRouter (automatic for sk-or- keys)
# OPENAI_BASE_URL=http://localhost:4000            # LiteLLM proxy
# OPENAI_BASE_URL=http://localhost:11434/v1        # Ollama
LLM_TEMPERATURE=0.2

# ---------- Environment + database ----------
# local -> SQLite (default below). test/prod run on Cloud Run with Cloud SQL Postgres
# and refuse to start on anything else; their DATABASE_URL comes from Secret Manager.
APP_ENV=local
# Runs, 👍/👎 votes, Slack event claims AND LangGraph conversation memory, one file:
DATABASE_URL=sqlite:///./data/agent.db
# Rehearse the cloud setup locally (`make db` starts Postgres in Docker):
# DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
DB_POOL_MIN=1
DB_POOL_MAX=5

# ---------- Agent ----------
AGENT_MAX_STEPS=12
AGENT_MAX_INPUT_CHARS=4000

# ---------- REST API ----------
# If set, /api/* requires header  X-API-Key: <value>
API_KEY=
LOG_LEVEL=INFO

# ---------- RAG: course FAQ bot (LlamaIndex + Qdrant) ----------
RAG_ENABLED=true
RAG_COURSES_FILE=config/courses.yaml        # courses, their Slack channels and sources
# RAG_CHANNEL_MAP=C0123ABCD=llm,C0456EFGH=de   # route YOUR workspace's channels without editing the YAML
# RAG_DEFAULT_COURSE=llm                      # answer with RAG in every channel not listed
SLACK_CMD_FAQ=/faq

# Qdrant mode:
#   local    -> your Docker Qdrant (`make qdrant`), QDRANT_URL=http://localhost:6333
#   cloud    -> Qdrant Cloud: QDRANT_URL=https://<id>.<region>.cloud.qdrant.io:6333 + QDRANT_API_KEY
#   embedded -> no server at all, files under QDRANT_PATH (single process)
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=                              # cloud only (Qdrant Cloud console -> API keys)
QDRANT_COLLECTION_PREFIX=faq_                # collections become faq_llm, faq_de, ...

# Dense embeddings: fastembed runs locally (the first run downloads the model from Hugging Face)
EMBED_PROVIDER=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
# EMBED_PROVIDER=openai                       # any OpenAI-compatible /embeddings endpoint
# EMBED_MODEL=text-embedding-3-small
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-...
SPARSE_PROVIDER=bm25                         # built-in BM25, Qdrant computes the IDF

# Retrieval: 20 retrieved -> 10 after recency weighting -> 4 after re-ranking (like the original bot)
RAG_SEARCH_MODE=hybrid                       # hybrid | dense | sparse
RAG_TOP_K=20
RAG_RECENCY_TOP_K=10
RAG_FINAL_TOP_N=4
RERANK_PROVIDER=auto                         # auto = cohere if COHERE_API_KEY else none; or fastembed (local)
# COHERE_API_KEY=

# Ingestion
# GITHUB_TOKEN=ghp_...                       # optional: private repos, higher GitHub limits (GH_TOKEN works too)
FAQ_REPO=DataTalksClub/faq@main
# FAQ_LOCAL_PATH=/path/to/a/checkout/of/faq  # skip the download

